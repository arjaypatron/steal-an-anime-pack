
-- Anime Pack All-in-One GUI
-- Roblox Studio - Your Own Game

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "AnimePackHub"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 270, 0, 350)
frame.Position = UDim2.new(0.5, -135, 0.5, -175)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 45)
title.BackgroundTransparency = 1
title.Text = "ANIME PACK HUB"
title.TextColor3 = Color3.fromRGB(170, 100, 255)
title.TextSize = 22
title.Font = Enum.Font.GothamBold
title.Parent = frame

local features = {
    "Auto Farm",
    "Auto Collect",
    "Auto Sell",
    "ESP",
    "Speed Boost",
    "Auto Rebirth"
}

local states = {}

for i, name in ipairs(features) do
    states[name] = false

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.85, 0, 0, 35)
    button.Position = UDim2.new(0.075, 0, 0, 55 + (i-1)*45)
    button.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 14
    button.Text = name .. ": OFF"
    button.Parent = frame

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 8)
    buttonCorner.Parent = button

    button.MouseButton1Click:Connect(function()
        states[name] = not states[name]

        button.Text = name ..
            (states[name] and ": ON" or ": OFF")

        button.BackgroundColor3 = states[name]
            and Color3.fromRGB(110, 60, 180)
            or Color3.fromRGB(45, 45, 65)

        print(name, states[name])
    end)
end

local close = Instance.new("TextButton")
close.Size = UDim2.new(0, 30, 0, 30)
close.Position = UDim2.new(1, -35, 0, 5)
close.Text = "X"
close.TextColor3 = Color3.new(1, 1, 1)
close.BackgroundColor3 = Color3.fromRGB(180, 40, 50)
close.Parent = frame

close.MouseButton1Click:Connect(function()
    gui:Destroy()
end)
